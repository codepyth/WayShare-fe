# development | preview | staging | production — only production is indexable.
NEXT_PUBLIC_SITE_ENV=development

# Public base URL (canonicals, OG URLs, sitemap). Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Django API origin. Server-side only: /api/* is rewritten to it.
API_ORIGIN=https://wayshare-be.onrender.com
