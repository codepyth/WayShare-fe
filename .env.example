# Deployment environment: development | preview | staging | production
# Only "production" is indexable; anything else (or unset) is noindex.
NEXT_PUBLIC_SITE_ENV=development

# Public base URL of this deployment (used for canonicals, OG URLs, sitemap).
# Required when NEXT_PUBLIC_SITE_ENV=production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
